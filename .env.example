# Google Gemini API Key (Can also be entered directly in the browser UI)
# Get a free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# GetStream API Credentials (Can also be entered directly in the browser UI)
# Get free keys at: https://getstream.io (Dashboard -> Create App -> Video & Audio)
STREAM_API_KEY=your_stream_api_key_here
STREAM_API_SECRET=your_stream_api_secret_here

# Server Port (Default: 8000)
PORT=8000
